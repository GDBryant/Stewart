{
  "name": "@stewart/sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "stewart-sidecar": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/main.ts --bundle --format=cjs --platform=node --outfile=dist/sidecar.cjs",
    "typecheck": "tsc -p tsconfig.json --composite false --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@stewart/core": "workspace:*",
    "@stewart/protocol": "workspace:*",
    "@stewart/kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@vitest/coverage-v8": "3.2.4",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
