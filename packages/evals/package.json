  },
  "dependencies": {
    "@stewart/core": "workspace:*",
    "@stewart/protocol": "workspace:*",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
