{
  "name": "@stewart/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/catalog.data.json','dist/catalog.data.json')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stewart/protocol": "workspace:*",
    "yaml": "2.8.1",
    "zod": "3.25.76",
    "@stewart/kernel": "workspace:*",
    "@stewart/toolcall-format": "workspace:*",
    "@stewart/compaction": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
