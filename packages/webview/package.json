{
  "name": "@stewart/webview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --outfile=dist/webview.js --format=iife --minify && esbuild src/styles.css --outfile=dist/webview.css",
    "typecheck": "tsc -p tsconfig.json --composite false --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@stewart/protocol": "workspace:*",
    "preact": "10.27.2",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@testing-library/preact": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "esbuild": "0.25.12",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
