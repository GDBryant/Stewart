{
  "name": "stewart",
  "displayName": "Stewart",
  "description": "Multi-role AI assistant",
  "version": "2.1.0",
  "private": true,
  "publisher": "stewart",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GDBryant/Stewart.git"
  },
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stewart.openChat",
        "title": "Stewart: Open Chat"
      },
      {
        "command": "stewart.openSettings",
        "title": "Stewart: Open Settings"
      },
      {
        "command": "stewart.addSelectionToChat",
        "title": "Stewart: Add Selection to Chat"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "stewart.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "stewart"
        }
      ]
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').cpSync('../../packages/webview/dist','webview',{recursive:true})\" && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "typecheck": "tsc -p tsconfig.json --composite false --noEmit",
    "test": "vitest run --passWithNoTests",
    "package": "vsce package --no-dependencies --skip-license --out stewart.vsix"
  },
  "dependencies": {
    "@stewart/core": "workspace:*",
    "@stewart/protocol": "workspace:*",
    "@stewart/webview": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/vscode": "1.145.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
